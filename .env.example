# ============================================
# 环境配置（非敏感）
# 复制 .env.example 为 .env 后修改：cp .env.example .env && vim .env
# ============================================

# Docker Compose 项目名称
COMPOSE_PROJECT_NAME=knowflow

# 运行环境
NODE_ENV=development

# 服务端口（主机端口，容器内固定为后端 3000 / 前端 8000）
BACKEND_PORT=3002
FRONTEND_PORT=8002

# MongoDB 外部访问端口（留空=不暴露）
# MONGODB_EXTERNAL_PORT=27017

# ============================================
# 后端配置
# ============================================
API_VERSION=v1

# 数据目录
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# 插件目录
PLUGINS_DIR=./plugins

# MongoDB 连接串
# Docker 部署默认 mongodb://mongodb:27017，本地开发默认 mongodb://localhost:27017
# MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=knowflow

# AI 配置（豆包，可选）
# Key 留空时 AI 功能优雅降级；也可写入 secrets/doubao_api_key.txt（优先级更高）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=ep-20260304151850-xqxr9

# CORS 配置
CORS_ORIGINS=*

# ============================================
# 前端配置
# ============================================
VITE_APP_TITLE=KnowFlow
VITE_APP_DESCRIPTION=知识管理系统
VITE_APP_VERSION=1.0.0

# 本地开发时由 scripts/start.sh 覆盖为相对路径走 Vite 代理
# Docker 部署时前端同源请求 /api/v1，由 nginx 代理到后端
VITE_API_BASE_URL=http://localhost:${BACKEND_PORT}

# 仅前端模式：指定后端 API 地址
FRONTEND_API_BASE_URL=http://localhost:3000

# API 超时（毫秒）
VITE_API_TIMEOUT=30000

# 功能开关
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK=false
